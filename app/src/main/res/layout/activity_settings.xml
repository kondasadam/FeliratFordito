<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:title="Beállítások" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Fordítás -->
            <TextView style="@style/SectionTitle" android:text="Fordítás" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fordító"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <RadioGroup
                        android:id="@+id/engineGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/engineGemini"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Gemini – pontosabb, érti a jelenetet (kulcs kell)" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/engineGoogle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Google Fordító – kulcs nélkül" />
                    </RadioGroup>

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Gemini API-kulcs"
                        app:endIconMode="password_toggle"
                        app:helperText="Ingyenes kulcs: aistudio.google.com/apikey">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/keyEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="textPassword"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>



                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Fordítás minősége"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <RadioGroup
                        android:id="@+id/qualityGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/qualityEco"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Takarékos – a telefon olvas (kb. 5–20 Ft/óra)" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/qualityPro"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Profi – a Gemini nézi a képet (kb. 15–35 Ft/óra, ajánlott)" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/qualityMax"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Csúcs – erősebb modell + kép (kb. 60–100 Ft/óra)" />
                    </RadioGroup>





                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Gemini modell (haladó)"
                        app:helperText="Hagyd így, ha nem tudod, mi ez">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/modelEdit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Egyenleg és fogyasztás -->
            <TextView style="@style/SectionTitle" android:text="Gemini egyenleg és fogyasztás" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Becsült egyenleg"
                        android:textColor="@color/text_dim"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/balanceText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/accent"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/usageText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Feltöltött összeg ($)">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/topupEdit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/topupBtn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Feltöltöttem" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Írd be, mennyit töltöttél fel (pl. 5), és nyomd meg a gombot. Új feltöltésnél add meg az új teljes egyenleget. A fogyasztást az app a Gemini válaszaiból számolja, ezért ez becslés."
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/studioBtn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Pontos egyenleg az AI Studióban" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Ár (haladó): dollár / 1 millió token"
                        android:textColor="@color/text_dim"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="Bemenet">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/priceInEdit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:hint="Kimenet">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/priceOutEdit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="numberDecimal"
                                android:singleLine="true" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Leolvasás -->
            <TextView style="@style/SectionTitle" android:text="Leolvasás" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

                <RadioGroup
                    android:id="@+id/readGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/readPhoto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pontos – éles fényképekből olvas (ajánlott)" />

                    <com.google.android.material.radiobutton.MaterialRadioButton
                        android:id="@+id/readVideo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Gyors – videóképből olvas, kevésbé pontos" />
                </RadioGroup>
            </com.google.android.material.card.MaterialCardView>

            <!-- Megjelenítés -->
            <TextView style="@style/SectionTitle" android:text="Megjelenítés" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Fordítás megjelenítése"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <RadioGroup
                        android:id="@+id/modeGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/modeAr"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Az angol felirat helyén, a képen" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/modeCard"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Külön kártyán, nagy betűkkel" />
                    </RadioGroup>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Betűméret (kártyás módban)"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/sizeSlider"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:stepSize="2"
                        android:value="26"
                        android:valueFrom="14"
                        android:valueTo="48" />

                    <TextView
                        android:id="@+id/sizeSample"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingBottom="8dp"
                        android:text="Ruth Singer: Köszönöm, hogy beszéltél velem."
                        android:textColor="#FFFFFF"
                        android:textStyle="bold" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/enSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Angol eredeti mutatása a fordítás alatt" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/bottomSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kártya a képernyő alján" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Névjegy -->
            <TextView style="@style/SectionTitle" android:text="Az appról" />

            <com.google.android.material.card.MaterialCardView style="@style/SettingsCard">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/versionText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/updateInfo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_dim" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/checkUpdateBtn"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Frissítés keresése" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
